# ============================================================
#  DocFlow — .env (เวอร์ชัน 2.1 · Security hardened)
#  วิธีใช้: สำเนา .env เก่าเก็บไว้ก่อน (cp .env .env.old) แล้ววางทับ
# ============================================================

# ===== ฐานข้อมูล PostgreSQL =====
POSTGRES_USER=docflow
# ⚠️ ตั้งรหัสใหม่ (รหัสเก่าอาจเคยหลุด) — เปลี่ยนแล้วต้องรัน: sh fix-db-login.sh เพื่อให้ DB รับรหัสใหม่ตาม
POSTGRES_PASSWORD=HVi3rj4e…L9e5
POSTGRES_DB=docflow
DB_PORT=5432
ADMINER_PORT=8080

# ===== เว็บ =====
APP_PORT=3000
APP_BIND=0.0.0.0            # ใช้ Cloudflare Tunnel อย่างเดียว → เปลี่ยนเป็น 127.0.0.1
ACCESS_KEY=                 # ⟵ ใส่ค่าเดิมถ้าคุณเคยตั้ง (ว่าง = ไม่บังคับ)
SESSION_HOURS=12
LOCK_ISSUED_DOCS=true

# ⚠️ [บังคับรุ่น 2.1] คีย์เซ็น session — ค่าใหม่ (ค่าเก่าถือว่ารั่ว/เลิกใช้)
#   ถ้าอยากเปลี่ยนเองทีหลัง: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
TOKEN_SECRET=5e3315c9b138a749ace6932c5714ce73b351eb265de...90223777
# ⚠️ [บังคับเมื่อใช้เมนู "สำรองข้อมูลทั้งระบบ"] — ลืม = กู้ backup ไม่ได้ จดไว้ในที่ปลอดภัย
BACKUP_PASSPHRASE=ppGPLdnI…Jyem
# ให้ createFirstAdmin ผ่านหน้าเว็บต้องกรอกรหัสยืนยัน (ว่าง = ไม่บังคับ — เครื่องใน LAN ปล่อยว่างได้)
BOOTSTRAP_ADMIN_KEY=

# ===== อีเมลแจ้งเตือน =====
SMTP_URL=                   # ⟵ ใส่ค่าเดิมจาก .env เก่า (smtps://...)
MAIL_FROM=                  # ⟵ ใส่ค่าเดิม

# ===== สมัครใช้งาน / ทดลองใช้ =====
ALLOW_SIGNUP=on             # รุ่น 2.1 ค่าเริ่มต้น=ปิด · เปิด=on
TRIAL_DAYS=7
SIGNUP_USER_QUOTA=1
SIGNUP_COMPANY_QUOTA=1
SIGNUP_PER_HOUR=5

# ===== งานตั้งเวลา =====
CRON=on
LICENSE_CRON="0 8 * * *"
BACKUP_CRON="0 2 * * *"
BACKUP_KEEP_DAYS=30
TRASH_KEEP_DAYS=30
TRASH_CRON="0 3 * * *"
MAINT_CRON="30 3 * * *"
FULL_BACKUP_CRON="0 1 * * *"
FULL_BACKUP_KEEP=7

# ===== Cloudflare Tunnel =====
CLOUDFLARE_TUNNEL_TOKEN=    # ⟵ ใส่ค่าเดิมจาก .env เก่า
COMPOSE_PROFILES=           # ⟵ ของเดิม (เช่น tunnel,backup — ว่าง = ไม่เปิด)

# ===== สำรองลงไดรฟ์/GDrive (compose profile: backup) =====
BACKUP_LOCAL_DIR=./Backups
RCLONE_REMOTE=              # ⟵ ใส่ค่าเดิม (เช่น gdrive:DocFlow-Backup)

# ===== Telegram =====
TELEGRAM_BOT_TOKEN=         # ⟵ ใส่ค่าเดิม (คุณเลือกไม่ revoke — ใช้ต่อได้เลย)
TELEGRAM_CHAT_IDS=          # ⟵ ใส่ค่าเดิม
TELEGRAM_REPLY_AS=          # ⟵ ใส่ค่าเดิม (ว่าง = Super Admin คนแรก)

# ===== ความทนทาน =====
PG_POOL_MAX=10
PG_STATEMENT_TIMEOUT=60000
PG_IDLE_TX_TIMEOUT=120000
PDF_CONCURRENCY=2
PDF_QUEUE_MAX=50
LOGIN_IP_MAX_FAIL=20
LOGIN_ACCOUNT_MAX_FAIL=20
LOGIN_LOG_DAYS=180
DISK_WARN_PCT=10

# ===== Path บนเครื่อง (show ในหน้าเว็บ) =====
STORAGE_LOCAL_DIR=./Storage
#TRIAL_DAYS=7
