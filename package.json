{
  "name": "docflow",
  "version": "2.0.0",
  "private": true,
  "description": "DocFlow — ระบบจัดการเอกสารธุรกิจ (Node.js + Express + PostgreSQL)",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
