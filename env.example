# ============================================================
#  DocFlow — ไฟล์ตั้งค่า
#  วิธีใช้: คัดลอกเป็น .env  (cp .env.example .env)  แก้ค่าที่ต้องการ แล้วรัน docker compose up -d
# ============================================================

# ===== ฐานข้อมูล PostgreSQL =====
# ผู้ใช้/รหัสผ่าน/ชื่อฐานข้อมูล (ตั้งก่อนรันครั้งแรก ถ้าเปลี่ยนทีหลังต้อง docker compose down -v ซึ่งข้อมูลจะหาย)
POSTGRES_USER=paella
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=docflow
# พอร์ตสำหรับเข้าดูฐานข้อมูลจากเครื่องเซิร์ฟเวอร์ (DBeaver / pgAdmin / psql)
DB_PORT=5432
# พอร์ตหน้าเว็บ Adminer สำหรับดูฐานข้อมูล (http://localhost:8080)
ADMINER_PORT=8080
# ใช้เฉพาะตอนรันนอก Docker หรือใช้ Postgres ภายนอก (docker compose ตั้งให้เอง)
# PGHOST=localhost
# (หรือใส่ DATABASE_URL=postgres://user:password@host:5432/db — อักขระพิเศษในรหัสผ่านต้องเข้ารหัส เช่น @ = %40)
# เปิดเมื่อใช้ Postgres บน cloud ที่บังคับ SSL
# PG_SSL=true

# ===== เว็บ =====
# พอร์ตของหน้าเว็บ DocFlow (http://localhost:3000)
APP_PORT=3000
# 0.0.0.0 = เข้าจากเครื่องอื่นในวง LAN ได้ · ถ้าใช้ผ่าน Cloudflare Tunnel อย่างเดียว แนะนำ 127.0.0.1 (คนนอกเข้าพอร์ตนี้ตรง ๆ ไม่ได้)
APP_BIND=0.0.0.0
# (ไม่บังคับ) ถ้าตั้งไว้ ต้องเปิดเว็บด้วย ?key=ค่านี้
ACCESS_KEY=
# (ไม่บังคับ) ว่างไว้ = ระบบสร้างให้และเก็บในฐานข้อมูล
TOKEN_SECRET=
# อายุการล็อกอิน (ชั่วโมง)
SESSION_HOURS=12
# เอกสารที่ออกแล้ว/ชำระแล้ว แก้ได้เฉพาะ admin และต้องระบุเหตุผล
LOCK_ISSUED_DOCS=true

# ===== ที่เก็บไฟล์ =====
# เก็บในระบบ ที่โฟลเดอร์ Storage (ข้างไฟล์ docker-compose.yml) แยกหมวดให้อัตโนมัติ:
#   Storage/01 เอกสาร PDF   / [บริษัท] / [ประเภทเอกสาร] / [ปี] / [เดือน]
#   Storage/02 ไฟล์อัพโหลด  / [บริษัท] / [ประเภทไฟล์] / [ลูกค้า] / [ปี] / [เดือน]
#   Storage/03 สำรองข้อมูล  / [วันที่]
#   Storage/04 ไฟล์แชท      / [ผู้ใช้] / [ปี-เดือน]
#   Storage/99 ถังขยะ       / ไฟล์ที่ถูกลบ เก็บ 30 วันแล้วลบถาวร (Super Admin / ผู้ตรวจสอบกู้คืนได้)

# ===== อีเมลแจ้งเตือน License =====
# ตัวอย่าง Gmail: smtps://you@gmail.com:app-password@smtp.gmail.com:465  (ใช้ App Password ของ Google)
SMTP_URL=
MAIL_FROM=

# ===== งานตั้งเวลา =====
# off = ปิดงานอัตโนมัติทั้งหมด
CRON=on
# แจ้งเตือน License ทุกวัน 08:00
LICENSE_CRON="0 8 * * *"
# สำรองข้อมูลเป็น JSON ทุกวัน 02:00 ไว้ใน Storage/03 สำรองข้อมูล
BACKUP_CRON="0 2 * * *"
# เก็บไฟล์สำรองย้อนหลัง (วัน)
BACKUP_KEEP_DAYS=30
# ถังขยะ: ไฟล์ที่ถูกลบย้ายไป Storage/99 ถังขยะ เก็บไว้กี่วันก่อนลบถาวร (ดู/กู้คืนได้เฉพาะ Super Admin ที่เมนู "ถังขยะ")
TRASH_KEEP_DAYS=30
# ลบไฟล์ในถังขยะที่ครบกำหนดแล้ว ทุกวัน 03:00
TRASH_CRON="0 3 * * *"

# ===== สมัครใช้งานฟรี (ปุ่ม "สมัครใช้งานฟรี" หน้าเข้าสู่ระบบ) =====
# on = เปิดรับสมัคร · off = ปิด (ซ่อนปุ่มสมัคร)
ALLOW_SIGNUP=on
# จำนวนวันทดลองใช้ฟรี (หมดอายุแล้วเข้าสู่ระบบไม่ได้ ต้องติดต่อเจ้าหน้าที่ — Super Admin ต่ออายุได้ที่เมนู License)
TRIAL_DAYS=7
# จำกัดการสมัครต่อ 1 IP ต่อชั่วโมง (กันสแปม)
SIGNUP_PER_HOUR=5

# ===== Cloudflare Tunnel (เปิดเว็บสู่อินเทอร์เน็ตผ่านโดเมนของคุณ) =====
# 1) Cloudflare → Zero Trust → Networks → Tunnels → Create a tunnel → Cloudflared → คัดลอก token (ข้อความยาวหลัง --token)
# 2) วาง token ด้านล่าง และเปลี่ยน COMPOSE_PROFILES เป็น tunnel   3) docker compose up -d
# 4) ในหน้า tunnel → Public Hostname: Subdomain/Domain ที่ต้องการ · Service Type = HTTP · URL = app:3000
CLOUDFLARE_TUNNEL_TOKEN=
# ว่าง = ปิด tunnel · tunnel = เปิด
COMPOSE_PROFILES=

# ===== สำรองข้อมูลทั้งระบบอัตโนมัติ (ฐานข้อมูล + Storage + .env) =====
# เปิดใช้: ใส่ backup ใน COMPOSE_PROFILES (เช่น COMPOSE_PROFILES=backup หรือ tunnel,backup)
# เวลาสำรอง (ค่าเริ่มต้นทุกวัน 02:30)
BACKUP_ALL_CRON="30 2 * * *"
# โฟลเดอร์ปลายทางในเครื่อง (ค่าเริ่มต้น ./Backups) — ถ้าลง Google Drive for desktop ไว้ ใส่ path โฟลเดอร์ใน Google Drive ได้เลย
#   Mac ตัวอย่าง: /Users/ชื่อผู้ใช้/Library/CloudStorage/GoogleDrive-อีเมล/My Drive/DocFlow-Backup
BACKUP_LOCAL_DIR=./Backups
# ส่งขึ้น Google Drive ผ่าน rclone (ต้องมีไฟล์ backup/rclone.conf) เช่น gdrive:DocFlow-Backup · ว่าง = ไม่ส่ง
RCLONE_REMOTE=

# ===== ความทนทาน / ความปลอดภัย =====
# จำนวนการเชื่อมต่อฐานข้อมูลสูงสุด · เวลาสูงสุดต่อคำสั่ง SQL (ms) · transaction ที่ค้างนานเกินนี้ถูกตัด (ms)
PG_POOL_MAX=10
PG_STATEMENT_TIMEOUT=60000
PG_IDLE_TX_TIMEOUT=120000
# สร้าง PDF พร้อมกันได้กี่ไฟล์ (เกินจะต่อคิว) — เครื่อง RAM น้อยใช้ 1-2
PDF_CONCURRENCY=2
# 1 IP ใส่รหัสผิดได้กี่ครั้งต่อ 10 นาที (นับรวมทุกชื่อผู้ใช้)
LOGIN_IP_MAX_FAIL=20
# เก็บประวัติการเข้าสู่ระบบกี่วัน · เวลางานดูแลฐานข้อมูลประจำวัน · เตือนเมื่อดิสก์ว่างน้อยกว่ากี่ %
LOGIN_LOG_DAYS=180
MAINT_CRON=30 3 * * *
DISK_WARN_PCT=10

# ===== สำรองทั้งระบบจากหน้าเว็บ (เมนู ระบบ → สำรอง / กู้คืนข้อมูล) =====
# ไฟล์เก็บที่ Backups/full (ตาม BACKUP_LOCAL_DIR) · ตั้งเวลาสำรองอัตโนมัติได้ในหน้าเว็บ (ทุกวัน / ทุกสัปดาห์ / ทุกเดือน)
# 2 ค่านี้เป็นค่าเริ่มต้นก่อนตั้งในหน้าเว็บเท่านั้น (ทุกคืน 01:00 เก็บ 7 ชุด) · ชุดที่กดสำรองเองไม่ถูกลบอัตโนมัติ
FULL_BACKUP_CRON=0 1 * * *
FULL_BACKUP_KEEP=7

# ===== ที่เก็บไฟล์ (ดิสก์ลูกที่ 2 / NAS QNAP / แชร์โฟลเดอร์) =====
# ต้อง mount ดิสก์หรือ NAS เข้ากับเครื่องเซิร์ฟเวอร์ก่อน (ดู README หัวข้อ "เก็บไฟล์บนดิสก์ลูกที่ 2 หรือ NAS")
# STORAGE_LOCAL_DIR = ไฟล์ของระบบ (PDF / ไฟล์อัปโหลด / ไฟล์แชท) · BACKUP_LOCAL_DIR (ด้านบน) = ไฟล์สำรอง
# ตัวอย่าง: STORAGE_LOCAL_DIR=/mnt/data/docflow/Storage   BACKUP_LOCAL_DIR=/mnt/qnap/docflow-backup
# ** ฐานข้อมูล PostgreSQL ควรอยู่บนดิสก์ในเครื่องเสมอ (ไม่ควรวางบน NAS) **
STORAGE_LOCAL_DIR=./Storage

# ===== Telegram: แจ้งเตือนและตอบแชทของผู้ใช้ผ่าน Telegram =====
# 1) สร้าง Bot กับ @BotFather (/newbot) แล้วใส่ token ด้านล่าง  2) docker compose up -d
# 3) เปิด Bot ใน Telegram พิมพ์ /start → Bot จะบอก chat ID → ใส่ใน TELEGRAM_CHAT_IDS แล้ว docker compose up -d อีกครั้ง
# หลายคนช่วยกันตอบ: สร้างกลุ่ม Telegram เชิญ Bot เข้ากลุ่ม พิมพ์ /start ในกลุ่ม แล้วใช้ chat ID ของกลุ่ม (ขึ้นต้นด้วย -)
# TELEGRAM_REPLY_AS = ชื่อผู้ใช้ Super Admin ที่จะแสดงเป็นผู้ตอบ (ว่าง = Super Admin คนแรก)
TELEGRAM_BOT_TOKEN=REMOVED-BOT-TOKEN
TELEGRAM_CHAT_IDS=REMOVED-CHAT-ID
TELEGRAM_REPLY_AS=paella
